[Unit]
Description=Seedr - BitTorrent ratio master
Documentation=https://github.com/rursache/Seedr
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=seedr
Group=seedr
WorkingDirectory=/opt/seedr
Environment=NODE_ENV=production
Environment=DATA_DIR=/var/lib/seedr
# Overrides (HOST, WEB_PORT, USERNAME, PASSWORD, ...) live in /etc/default/seedr
EnvironmentFile=-/etc/default/seedr
ExecStart=/opt/seedr/node dist/index.js
Restart=on-failure
RestartSec=5

# /var/lib/seedr is created and owned by the service user
StateDirectory=seedr

# Hardening
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true

[Install]
WantedBy=multi-user.target
