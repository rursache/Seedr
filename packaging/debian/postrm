#!/bin/sh
set -e

case "$1" in
  remove)
    [ -d /run/systemd/system ] && systemctl daemon-reload || true
    ;;
  purge)
    rm -rf /var/lib/seedr
    if getent passwd seedr >/dev/null; then
      deluser --system seedr || true
    fi
    if getent group seedr >/dev/null; then
      delgroup --system seedr || true
    fi
    [ -d /run/systemd/system ] && systemctl daemon-reload || true
    ;;
esac

exit 0
