# Seedr service settings. Restart the "Seedr" service after editing
# (services.msc, or: net stop Seedr && net start Seedr).
#
# The web UI has no authentication by default, so it only listens on the local
# machine. Use HOST=0.0.0.0 to reach it from other devices, and set USERNAME and
# PASSWORD together if you do.
HOST=127.0.0.1
WEB_PORT=8080
#USERNAME=admin
#PASSWORD=changeme
#LOG_LEVEL=info
