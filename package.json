{
  "name": "seedr",
  "version": "1.0.0",
  "description": "BitTorrent ratio master - emulates BT clients and reports upload to private trackers",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "sh scripts/version.sh && tsc && cp src/version.json dist/version.json && cd ui && npm run build",
    "build:backend": "tsc",
    "build:ui": "cd ui && npm run build",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@fastify/cors": "^11.0.0",
    "@fastify/multipart": "^10.1.0",
    "@fastify/static": "^10.1.2",
    "bencode": "^4.0.0",
    "chokidar": "^5.0.0",
    "fastify": "^5.8.1",
    "pino": "^10.3.1",
    "pino-pretty": "^13.0.0",
    "randexp": "^0.5.3",
    "socket.io": "^4.8.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "tsx": "^4.19.3",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  }
}
